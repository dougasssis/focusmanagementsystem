{% extends 'base_template.html' %}
{% load static %}
{% load i18n %}

{% block page_title %}
{% trans "Graduation Requirements" %}
{% endblock page_title %}

{% block content %}
<section class="content">
  <div class="container-fluid">
    <div class="row mb-3">
      <div class="col-12">
        <div class="card card-primary">
          <div class="card-header">
            <h3 class="card-title">{% trans "Graduation Requirements" %}</h3>
          </div>
          <div class="card-body">
            <p class="text-muted">
              {% trans "Below are the minimum class attendance requirements for belt promotions and stripes." %}
            </p>
            
            {% if user.is_superuser %}
            <div class="mb-3">
              <a href="{% url 'focusbjj:update_graduation_requirements' %}" class="btn btn-primary">
                <i class="fas fa-edit"></i> {% trans "Update Requirements" %}
              </a>
            </div>
            {% endif %}
            
            <div class="row">
              <div class="col-12">
                <div class="card card-outline card-primary">
                  <div class="card-header">
                    <h3 class="card-title">{% trans "Belt Requirements" %}</h3>
                  </div>
                  <div class="card-body p-0">
                    <table class="table table-striped">
                      <thead>
                        <tr>
                          <th>{% trans "Belt" %}</th>
                          <th>{% trans "Stripes" %}</th>
                          <th>{% trans "Required Classes" %}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {% for req in requirements %}
                        <tr>
                          <td>
                            <div class="d-flex align-items-center">
                              {% with belt_slug=req.belt|lower|slugify %}
                              <div class="belt-block {{ belt_slug }}-belt mr-2"></div>
                              {{ req.belt }}
                              {% endwith %}
                            </div>
                          </td>
                          <td>{{ req.stripes }}</td>
                          <td>{{ req.required_classes }}</td>
                        </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .belt-block {
    width: 60px;
    height: 20px;
    border-radius: 2px;
    border: 1px solid #999;
  }
  
  /* Basic belt colors */
  .white-belt {
    background-color: #ffffff;
  }
  
  .blue-belt {
    background-color: #3490dc;
  }
  
  .purple-belt {
    background-color: #9561e2;
  }
  
  .brown-belt {
    background-color: #8a6d3b;
  }
  
  .black-belt {
    background-color: #2a2a2a;
  }
  
  .gray-belt {
    background-color: #a9a9a9;
  }
  
  .yellow-belt {
    background-color: #ffd700;
  }
  
  .orange-belt {
    background-color: #ff8c00;
  }
  
  .green-belt {
    background-color: #008000;
  }
  
  /* Mixed belt colors */
  .graywhite-belt {
    background: linear-gradient(to right, #a9a9a9 50%, #ffffff 50%);
  }
  
  .grayblack-belt {
    background: linear-gradient(to right, #a9a9a9 50%, #2a2a2a 50%);
  }
  
  .yellowwhite-belt {
    background: linear-gradient(to right, #ffd700 50%, #ffffff 50%);
  }
  
  .yellowblack-belt {
    background: linear-gradient(to right, #ffd700 50%, #2a2a2a 50%);
  }
  
  .orangewhite-belt {
    background: linear-gradient(to right, #ff8c00 50%, #ffffff 50%);
  }
  
  .orangeblack-belt {
    background: linear-gradient(to right, #ff8c00 50%, #2a2a2a 50%);
  }
  
  .greenwhite-belt {
    background: linear-gradient(to right, #008000 50%, #ffffff 50%);
  }
  
  .greenblack-belt {
    background: linear-gradient(to right, #008000 50%, #2a2a2a 50%);
  }
</style>
{% endblock content %} 